{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc://schemas/manual-seed-graph@4",
  "title": "Recursive manual seed graph",
  "oneOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "$ref": "#/$defs/leaf"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^uc://"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "identity",
        "kind",
        "bases",
        "provides"
      ],
      "properties": {
        "format": {
          "const": "manual-seed-base-1"
        },
        "identity": {
          "type": "string",
          "pattern": "^uc://"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "bases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "provides": {
          "type": "object"
        }
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "bases",
        "what"
      ],
      "properties": {
        "format": {
          "const": "manual-what-seed-4"
        },
        "bases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "what": {
          "$ref": "#/$defs/what"
        }
      }
    },
    "what": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "semantics",
        "state",
        "presentation",
        "program",
        "acceptance"
      ],
      "properties": {
        "acceptance": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "expected": {
                "type": "object"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "input": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "input",
              "expected"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "boundaries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "direction": {
                "enum": [
                  "inward",
                  "outward",
                  "inward-outward"
                ]
              },
              "effect": {
                "minLength": 1,
                "type": "string"
              },
              "identity": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "identity",
              "direction",
              "effect"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "canonical": {
              "pattern": "^uc://manual/calculators/.+@[1-9][0-9]*$",
              "type": "string"
            },
            "family": {
              "const": "calculator"
            },
            "variation": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "canonical",
            "family",
            "variation",
            "version"
          ],
          "type": "object"
        },
        "presentation": {
          "additionalProperties": false,
          "properties": {
            "keys": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "column": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "row": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "key",
                  "row",
                  "column"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "geometry": {
              "minLength": 1,
              "type": "string"
            },
            "layout": {
              "type": "object"
            },
            "mode_label": {
              "type": "string"
            },
            "theme": {
              "type": "object"
            },
            "title": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "title",
            "geometry",
            "mode_label",
            "layout",
            "theme",
            "keys"
          ],
          "type": "object"
        },
        "program": {
          "additionalProperties": false,
          "properties": {
            "case_entrypoint": {
              "minLength": 1,
              "type": "string"
            },
            "language": {
              "const": "calculator-declaration-1"
            },
            "launch_entrypoint": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "language",
            "case_entrypoint",
            "launch_entrypoint"
          ],
          "type": "object"
        },
        "semantics": {
          "additionalProperties": false,
          "properties": {
            "numeric_laws": {
              "type": "object"
            },
            "operations": {
              "additionalProperties": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "type": "object"
            },
            "validation": {
              "type": "object"
            }
          },
          "required": [
            "numeric_laws",
            "operations",
            "validation"
          ],
          "type": "object"
        },
        "state": {
          "additionalProperties": false,
          "properties": {
            "authority": {
              "const": "declarations"
            },
            "fields": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "initial": {
              "type": "object"
            }
          },
          "required": [
            "authority",
            "fields",
            "initial"
          ],
          "type": "object"
        },
        "transitions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "argument": {},
              "event": {
                "minLength": 1,
                "type": "string"
              },
              "route": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "event",
              "route"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      }
    }
  }
}
