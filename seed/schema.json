{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "uc://schemas/manual-seed-graph@5",
  "title": "Recursive manual seed graph",
  "oneOf": [
    {
      "$ref": "#/$defs/root"
    },
    {
      "$ref": "#/$defs/base"
    },
    {
      "$ref": "#/$defs/leaf"
    }
  ],
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "identity",
        "scope",
        "standard",
        "machine",
        "operation",
        "authorities",
        "fixed_point",
        "open_gaps"
      ],
      "properties": {
        "format": {"const": "unified-root-seed-1"},
        "identity": {"type": "string", "pattern": "^uc://roots/.+@[1-9][0-9]*$"},
        "scope": {"const": "application-language-convergence"},
        "standard": {"type": "object"},
        "machine": {"type": "object"},
        "operation": {"type": "object"},
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference"}
        },
        "fixed_point": {"type": "object"},
        "open_gaps": {"type": "array", "maxItems": 0}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^uc://"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "identity",
        "kind",
        "bases",
        "provides"
      ],
      "properties": {
        "format": {
          "const": "manual-seed-base-1"
        },
        "identity": {
          "type": "string",
          "pattern": "^uc://"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "bases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "provides": {
          "type": "object"
        }
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "bases",
        "what"
      ],
      "properties": {
        "format": {
          "const": "manual-what-seed-4"
        },
        "bases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "what": {
          "$ref": "#/$defs/what"
        }
      }
    },
    "what": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "semantics",
        "state",
        "presentation",
        "program",
        "acceptance"
      ],
      "properties": {
        "acceptance": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "expected": {
                "type": "object"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "input": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "input",
              "expected"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "boundaries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "direction": {
                "enum": [
                  "inward",
                  "outward",
                  "inward-outward"
                ]
              },
              "effect": {
                "minLength": 1,
                "type": "string"
              },
              "identity": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "identity",
              "direction",
              "effect"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "canonical": {
              "pattern": "^uc://manual/(calculators|applications)/.+@[1-9][0-9]*$",
              "type": "string"
            },
            "family": {"type": "string", "minLength": 1},
            "variation": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "canonical",
            "family",
            "variation",
            "version"
          ],
          "type": "object"
        },
        "presentation": {
          "additionalProperties": false,
          "properties": {
            "collection": {"type": "object"},
            "control_arguments": {"type": "object"},
            "entities": {"type": "array", "items": {"type": "object"}},
            "inputs": {"type": "array", "items": {"type": "object"}},
            "keys": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "column": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "row": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "key",
                  "row",
                  "column"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "geometry": {
              "minLength": 1,
              "type": "string"
            },
            "layout": {
              "type": "object"
            },
            "mode_label": {
              "type": "string"
            },
            "score_text": {"type": "string"},
            "self_tests": {"type": "array", "items": {"type": "object"}},
            "status": {"type": "object"},
            "surface": {"type": "object"},
            "text_fill": {"type": "string"},
            "theme": {
              "type": "object"
            },
            "title": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "title",
            "geometry",
            "keys"
          ],
          "type": "object"
        },
        "program": {
          "additionalProperties": false,
          "properties": {
            "case_entrypoint": {
              "minLength": 1,
              "type": "string"
            },
            "language": {
              "enum": [
                "calculator-declaration-1",
                "stateful-interface-declaration-1",
                "bounded-simulation-declaration-1"
              ]
            },
            "launch_entrypoint": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "language",
            "case_entrypoint",
            "launch_entrypoint"
          ],
          "type": "object"
        },
        "semantics": {
          "additionalProperties": false,
          "properties": {
            "application_vocabulary": {"type": "array", "items": {"type": "string"}},
            "boundaries": {"type": "array", "items": {"type": "object"}},
            "calculations": {"type": "object"},
            "clock": {"type": "object"},
            "collisions": {"type": "array", "items": {"type": "object"}},
            "commands": {"type": "array", "items": {"type": "object"}},
            "controllers": {"type": "array", "items": {"type": "object"}},
            "motion": {"type": "array", "items": {"type": "object"}},
            "numeric_laws": {
              "type": "object"
            },
            "operations": {
              "additionalProperties": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "type": "object"
            },
            "validation": {
              "type": "object"
            },
            "thresholds": {"type": "array", "items": {"type": "object"}}
          },
          "anyOf": [
            {"required": ["numeric_laws", "operations"]},
            {"required": ["commands"]},
            {"required": ["clock", "motion", "validation"]}
          ],
          "type": "object"
        },
        "state": {
          "additionalProperties": false,
          "properties": {
            "authority": {
              "const": "declarations"
            },
            "fields": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "initial": {
              "type": "object"
            }
          },
          "required": [
            "authority",
            "fields",
            "initial"
          ],
          "type": "object"
        },
        "transitions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "argument": {},
              "event": {
                "minLength": 1,
                "type": "string"
              },
              "route": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "event",
              "route"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      }
    }
  }
}
