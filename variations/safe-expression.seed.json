{
  "schema_version": "manual-tk-generator-1",
  "variation_of": "../seed.json",
  "declared_differences": [
    "replace unsafe python.eval boundary with restricted arithmetic AST",
    "add parentheses and backspace controls",
    "add deterministic acceptance cases",
    "increase window size for the additional control row"
  ],
  "application": {
    "name": "simple-calculator",
    "title": "Simple Calculator — Seed Generated",
    "geometry": "300x230"
  },
  "theme": {
    "background": "light green",
    "button_background": "red",
    "button_foreground": "black"
  },
  "display": {
    "row": 0,
    "column": 0,
    "column_span": 4,
    "ipadx": 70
  },
  "expression": {
    "maximum_characters": 256,
    "binary_operators": {
      "+": "add",
      "-": "subtract",
      "*": "multiply",
      "/": "true_divide"
    },
    "unary_operators": {
      "+": "positive",
      "-": "negative"
    }
  },
  "controls": [
    {"label": "1", "action": "append", "value": "1", "row": 2, "column": 0},
    {"label": "2", "action": "append", "value": "2", "row": 2, "column": 1},
    {"label": "3", "action": "append", "value": "3", "row": 2, "column": 2},
    {"label": "+", "action": "append", "value": "+", "row": 2, "column": 3},
    {"label": "4", "action": "append", "value": "4", "row": 3, "column": 0},
    {"label": "5", "action": "append", "value": "5", "row": 3, "column": 1},
    {"label": "6", "action": "append", "value": "6", "row": 3, "column": 2},
    {"label": "-", "action": "append", "value": "-", "row": 3, "column": 3},
    {"label": "7", "action": "append", "value": "7", "row": 4, "column": 0},
    {"label": "8", "action": "append", "value": "8", "row": 4, "column": 1},
    {"label": "9", "action": "append", "value": "9", "row": 4, "column": 2},
    {"label": "*", "action": "append", "value": "*", "row": 4, "column": 3},
    {"label": "0", "action": "append", "value": "0", "row": 5, "column": 0},
    {"label": "Clear", "action": "clear", "value": "", "row": 5, "column": 1},
    {"label": "=", "action": "evaluate", "value": "", "row": 5, "column": 2},
    {"label": "/", "action": "append", "value": "/", "row": 5, "column": 3},
    {"label": ".", "action": "append", "value": ".", "row": 6, "column": 0},
    {"label": "(", "action": "append", "value": "(", "row": 6, "column": 1},
    {"label": ")", "action": "append", "value": ")", "row": 6, "column": 2},
    {"label": "⌫", "action": "backspace", "value": "", "row": 6, "column": 3}
  ],
  "acceptance": [
    {"expression": "1+2", "result": "3"},
    {"expression": "2+3*4", "result": "14"},
    {"expression": "(2+3)*4", "result": "20"},
    {"expression": "7/2", "result": "3.5"},
    {"expression": "-5+2", "result": "-3"},
    {"expression": "1/0", "error": "division-by-zero"},
    {"expression": "__import__('os')", "error": "invalid-expression"}
  ]
}
